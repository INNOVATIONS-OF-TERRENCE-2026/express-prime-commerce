# Client-safe environment variables only
# Copy to .env.local for local development. Never commit .env files.

VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# SECURITY RULES
# Never place Supabase service_role or sb_secret_* keys in any VITE_* variable.
# Never expose privileged credentials in browser/client code.
# Store privileged Supabase secrets only in server-side/Edge Function secret storage.
